rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function teacher() { return request.auth != null && 'email_verified' in request.auth.token && request.auth.token.email_verified == true && request.auth.token.email in ['happenz@naver.com', 'daesin24841@gmail.com']; }
    match /museums/dokdo-ullim-museum-v1/exhibits/{uid}/{file} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid && request.resource.size <= 25 * 1024 * 1024 && request.resource.contentType.matches('(image/.*|video/.*|application/pdf)');
      allow delete: if request.auth != null && (request.auth.uid == uid || teacher());
    }
  }
}
