{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dokdo-ullim",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "DokdoRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DokdoRoom"]
    }
  ]
}
