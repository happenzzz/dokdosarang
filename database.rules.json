{
  "rules": {
    "museumPresence": {
      "dokdo-ullim-museum-v1": {
        ".read": "auth != null",
        "$session": {
          ".write": "auth != null && ((!data.exists() && (!newData.exists() || newData.child('uid').val() == auth.uid)) || data.child('uid').val() == auth.uid)",
          ".validate": "newData.hasChildren(['uid','sessionId','name','x','y','lastSeenMs']) && newData.child('uid').val() == auth.uid && newData.child('sessionId').val() == $session",
          "uid": {
            ".validate": "newData.isString()"
          },
          "sessionId": {
            ".validate": "newData.isString()"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "group": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "studentId": {
            ".validate": "newData.isString()"
          },
          "x": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "y": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "lastSeenMs": {
            ".validate": "newData.isNumber() && newData.val() <= now + 1000"
          },
          "avatar": {
            ".validate": "newData.hasChildren(['face','hair','hairColor','outfit','accessory'])",
            "face": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 7"
            },
            "hair": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 11"
            },
            "hairColor": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 11"
            },
            "outfit": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 11"
            },
            "accessory": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8"
            },
            "$other": {
              ".validate": false
            }
          },
          "facing": {
            ".validate": "newData.val() == 'up' || newData.val() == 'down' || newData.val() == 'left' || newData.val() == 'right'"
          },
          "reaction": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "reactionAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
